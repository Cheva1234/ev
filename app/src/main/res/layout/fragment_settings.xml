<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ev_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="SETTINGS"
            android:textColor="@color/ev_off_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/section_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="MODEL"
            android:textColor="@color/ev_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/section_runtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="RUNTIME"
            android:textColor="@color/ev_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_disclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Progressive Tool Disclosure"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_unload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Auto Unload"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_ram_verify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="RAM Cleanup Verification"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/section_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="TOOLS"
            android:textColor="@color/ev_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_tool_math"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Math"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_tool_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Time"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_tool_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Weather"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_tool_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Web"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_tool_mail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Mail"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_tool_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Location"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/section_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="PRIVACY"
            android:textColor="@color/ev_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/section_developer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="DEVELOPER"
            android:textColor="@color/ev_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_verbose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Verbose logs"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_show_evcl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Show EVCL"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_show_tool_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Show tool results"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_show_prompt_tokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Show prompt tokens"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_show_ram_delta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Show RAM delta"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_raw_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_family"
            android:text="Raw model output"
            android:textColor="@color/ev_off_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_clear_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_setting_button"
            android:fontFamily="@font/jetbrains_mono_family"
            android:gravity="center"
            android:padding="12dp"
            android:text="Clear current session"
            android:textColor="@color/ev_amber"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_delete_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_setting_button"
            android:fontFamily="@font/jetbrains_mono_family"
            android:gravity="center"
            android:padding="12dp"
            android:text="Delete logs"
            android:textColor="@color/ev_amber"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_reset_ev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_setting_button"
            android:fontFamily="@font/jetbrains_mono_family"
            android:gravity="center"
            android:padding="12dp"
            android:text="Reset EV"
            android:textColor="@color/ev_red"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
